# Client ID is different from the numeric App ID. Keep the secret on the server.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
PUBLIC_BASE_URL=https://auth.example.com
HOST=127.0.0.1
PORT=3000
# Explicit local development only; PUBLIC_BASE_URL must then be a loopback URL.
ALLOW_HTTP_LOOPBACK=false
# Usually empty: Obsidian requestUrl does not need browser CORS.
ALLOWED_ORIGINS=
# Memory is for a single local process. Cloud Run refuses to boot without firestore.
SESSION_STORE=memory
# Optional project override; otherwise use the service account's ADC project.
FIRESTORE_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)
# Use a different namespace for each App/environment. Enable expireAt TTL on both collections.
FIRESTORE_COLLECTION_PREFIX=image_paste_auth
