{
	"name": "image-paste-on-github",
	"version": "1.2.1",
	"description": "Upload pasted images to your GitHub repository and insert the raw CDN link automatically.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"lint": "eslint src --max-warnings 0",
		"build": "npm run lint && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node --test tests/*.test.cjs",
		"test:relay": "npm run test:cloudflare",
		"test:cloudflare": "npm test --prefix relay/cloudflare",
		"test:browser": "npm run build && node --test tests/browser/*.test.cjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"github",
		"image",
		"upload",
		"cdn"
	],
	"author": "HyoYoonNam",
	"license": "MIT",
	"engines": {
		"node": "^20.19.0 || ^22.13.0 || >=24"
	},
	"devDependencies": {
		"@types/node": "^20.11.0",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "0.6.0",
		"esbuild": "0.20.0",
		"obsidian": "latest",
		"playwright-core": "1.65.1",
		"tslib": "2.6.2",
		"typescript": "5.3.3",
		"typescript-eslint": "^8.70.1"
	},
	"dependencies": {
		"heic-to": "1.6.7"
	}
}
