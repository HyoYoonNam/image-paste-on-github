{
	"name": "image-paste-on-github",
	"version": "1.1.0",
	"description": "Upload pasted images to your GitHub repository and insert the raw CDN link automatically.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node --test tests/*.test.cjs",
		"test:relay": "npm test --prefix relay",
		"test:cloudflare": "npm test --prefix relay/cloudflare",
		"test:browser": "npm run build && node --test tests/browser/*.test.cjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"github",
		"image",
		"upload",
		"cdn"
	],
	"author": "HyoYoonNam",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.11.0",
		"@typescript-eslint/eslint-plugin": "^7.0.0",
		"@typescript-eslint/parser": "^7.0.0",
		"esbuild": "0.20.0",
		"obsidian": "latest",
		"playwright-core": "1.65.1",
		"tslib": "2.6.2",
		"typescript": "5.3.3"
	},
	"dependencies": {
		"heic-to": "1.6.7"
	}
}
